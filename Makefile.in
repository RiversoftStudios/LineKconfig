DISTCLEANFILES = libs/parser/kconfig-parser.pc
# Still, .c files generated from .y files are not cleaned by default,
# so yconf.c must be explicitly listed:
MAINTAINERCLEANFILES = libs/parser/hconf.c libs/parser/lconf.c \
	libs/parser/yconf.c

# yconf.c not listed, because it is the real _SOURCES, but others are
# in _EXTRA_SOURCES (above), so must be listed:
BUILT_SOURCES = libs/parser/hconf.c libs/parser/lconf.c

#===============================================================================
# Docs
dist_doc_DATA = \
	docs/kconfig-language.txt \
	docs/kconfig.txt


#===============================================================================
# Libraries
SUFFIXES = .gperf
libs_parser_libkconfig_parser_la_SOURCES = libs/parser/yconf.y
dist_EXTRA_libs_parser_libkconfig_parser_la_SOURCES = \
	libs/parser/hconf.gperf \
	libs/parser/lconf.l \
	libs/parser/confdata.c \
	libs/parser/menu.c \
	libs/parser/symbol.c \
	libs/parser/util.c \
	libs/parser/expr.c \
	libs/parser/expr.h \
	libs/parser/lkc.h \
	libs/parser/lkc_proto.h

libs_parser_libkconfig_parser_la_CPPFLAGS = \
	-DROOTMENU="\"$(root_menu)\"" \
	-DCONFIG_=\"$(config_prefix)\" \
	-DGPERF_LEN_TYPE="$(GPERF_LEN_TYPE)" \
	$(intl_CPPFLAGS) \
	-I$(top_srcdir)/libs/parser \
	-I$(top_builddir)/libs/parser

libs_parser_libkconfig_parser_la_CFLAGS = \
	$(AM_CFLAGS) \
	$(kf_CFLAGS)

libs_parser_libkconfig_parser_la_LDFLAGS = \
	-release $(KCONFIGPARSER_LIB_VERSION) \
	-no-undefined

libs_parser_libkconfig_parser_la_LIBADD = $(intl_LIBS)
libs_parser_kconfig_includedir = $(includedir)/kconfig
libs_parser_kconfig_include_HEADERS = \
	libs/parser/list.h \
	libs/parser/lkc.h \
	libs/parser/expr.h \
	libs/parser/lkc_proto.h

AM_V_GPERF = $(AM_V_GPERF_$(V))
AM_V_GPERF_ = $(AM_V_GPERF_$(AM_DEFAULT_VERBOSITY))
AM_V_GPERF_0 = @echo "  GPERF   " $@;
AM_V_GPERF_1 = 

# libs/parser/kconfig-parser.pc generated by AC_CONFIG_FILES in configure.ac
pkgconfigdir = $(libdir)/pkgconfig
pkgconfig_DATA = libs/parser/kconfig-parser.pc
@COND_conf_TRUE@frontends_conf_kconfig_conf_SOURCES = frontends/conf/conf.c
@COND_conf_TRUE@frontends_conf_kconfig_conf_CPPFLAGS = \
@COND_conf_TRUE@	$(AM_CPPFLAGS) \
@COND_conf_TRUE@	$(intl_CPPFLAGS) \
@COND_conf_TRUE@	-I$(top_srcdir)/libs/parser

@COND_conf_TRUE@frontends_conf_kconfig_conf_CFLAGS = \
@COND_conf_TRUE@	$(AM_CFLAGS) \
@COND_conf_TRUE@	$(kf_CFLAGS)

@COND_conf_TRUE@frontends_conf_kconfig_conf_LDADD = \
@COND_conf_TRUE@	$(top_builddir)/libs/parser/libkconfig-parser.la \
@COND_conf_TRUE@	$(intl_LIBS) \
@COND_conf_TRUE@	$(conf_EXTRA_LIBS)

@COND_utils_TRUE@@COND_utils_gettext_TRUE@MAYBE_utils_gettext = utils/kconfig-gettext
@COND_utils_TRUE@utils_kconfig_gettext_SOURCES = utils/gettext.c
@COND_utils_TRUE@utils_kconfig_gettext_CPPFLAGS = \
@COND_utils_TRUE@	$(AM_CPPFLAGS) \
@COND_utils_TRUE@	-I$(top_srcdir)/libs/parser

@COND_utils_TRUE@utils_kconfig_gettext_CFLAGS = \
@COND_utils_TRUE@	$(AM_CFLAGS) \
@COND_utils_TRUE@	$(kf_CFLAGS)

@COND_utils_TRUE@utils_kconfig_gettext_LDADD = \
@COND_utils_TRUE@	$(top_builddir)/libs/parser/libkconfig-parser.la \
@COND_utils_TRUE@	$(intl_LIBS)

all: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) all-am

.SUFFIXES:
.SUFFIXES: .gperf .c .l .lo .o .obj .y
am--refresh: Makefile
	@:
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      echo ' cd $(srcdir) && $(AUTOMAKE) --foreign'; \
	      $(am__cd) $(srcdir) && $(AUTOMAKE) --foreign \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    echo ' $(SHELL) ./config.status'; \
	    $(SHELL) ./config.status;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	$(SHELL) ./config.status --recheck

$(top_srcdir)/configure:  $(am__configure_deps)
	$(am__cd) $(srcdir) && $(AUTOCONF)
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	$(am__cd) $(srcdir) && $(ACLOCAL) $(ACLOCAL_AMFLAGS)
$(am__aclocal_m4_deps):

scripts/.autostuff/config.h: scripts/.autostuff/stamp-h1
	@test -f $@ || rm -f scripts/.autostuff/stamp-h1
	@test -f $@ || $(MAKE) $(AM_MAKEFLAGS) scripts/.autostuff/stamp-h1

scripts/.autostuff/stamp-h1: $(top_srcdir)/scripts/.autostuff/config.h.in $(top_builddir)/config.status
	$(AM_V_at)rm -f scripts/.autostuff/stamp-h1
	$(AM_V_GEN)cd $(top_builddir) && $(SHELL) ./config.status scripts/.autostuff/config.h
$(top_srcdir)/scripts/.autostuff/config.h.in:  $(am__configure_deps) 
	$(AM_V_GEN)($(am__cd) $(top_srcdir) && $(AUTOHEADER))
	$(AM_V_at)rm -f scripts/.autostuff/stamp-h1
	$(AM_V_at)touch $@

distclean-hdr:
	-rm -f scripts/.autostuff/config.h scripts/.autostuff/stamp-h1
libs/parser/kconfig-parser.pc: $(top_builddir)/config.status $(top_srcdir)/libs/parser/kconfig-parser.pc.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
install-binPROGRAMS: $(bin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-binPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(bindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(bindir)" && $(am__rm_f) $$files

clean-binPROGRAMS:
	$(am__rm_f) $(bin_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(bin_PROGRAMS:$(EXEEXT)=)

clean-noinstLIBRARIES:
	-$(am__rm_f) $(noinst_LIBRARIES)

install-libLTLIBRARIES: $(lib_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(libdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(libdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(libdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(libdir)"; \
	}

uninstall-libLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(libdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(libdir)/$$f"; \
	done

clean-libLTLIBRARIES:
	-$(am__rm_f) $(lib_LTLIBRARIES)
	@list='$(lib_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	echo rm -f $${locs}; \
	$(am__rm_f) $${locs}
libs/parser/$(am__dirstamp):
	@$(MKDIR_P) libs/parser
	@: >>libs/parser/$(am__dirstamp)
libs/parser/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) libs/parser/$(DEPDIR)
	@: >>libs/parser/$(DEPDIR)/$(am__dirstamp)
libs/parser/libkconfig_parser_la-yconf.lo:  \
	libs/parser/$(am__dirstamp) \
	libs/parser/$(DEPDIR)/$(am__dirstamp)
libs/parser/libkconfig_parser_la-hconf.lo:  \
	libs/parser/$(am__dirstamp) \
	libs/parser/$(DEPDIR)/$(am__dirstamp)
libs/parser/libkconfig_parser_la-lconf.lo:  \
	libs/parser/$(am__dirstamp) \
	libs/parser/$(DEPDIR)/$(am__dirstamp)
libs/parser/libkconfig_parser_la-confdata.lo:  \
	libs/parser/$(am__dirstamp) \
	libs/parser/$(DEPDIR)/$(am__dirstamp)
libs/parser/libkconfig_parser_la-menu.lo: libs/parser/$(am__dirstamp) \
	libs/parser/$(DEPDIR)/$(am__dirstamp)
libs/parser/libkconfig_parser_la-symbol.lo:  \
	libs/parser/$(am__dirstamp) \
	libs/parser/$(DEPDIR)/$(am__dirstamp)
libs/parser/libkconfig_parser_la-util.lo: libs/parser/$(am__dirstamp) \
	libs/parser/$(DEPDIR)/$(am__dirstamp)
libs/parser/libkconfig_parser_la-expr.lo: libs/parser/$(am__dirstamp) \
	libs/parser/$(DEPDIR)/$(am__dirstamp)

libs/parser/libkconfig-parser.la: $(libs_parser_libkconfig_parser_la_OBJECTS) $(libs_parser_libkconfig_parser_la_DEPENDENCIES) $(EXTRA_libs_parser_libkconfig_parser_la_DEPENDENCIES) libs/parser/$(am__dirstamp)
	$(AM_V_CCLD)$(libs_parser_libkconfig_parser_la_LINK) -rpath $(libdir) $(libs_parser_libkconfig_parser_la_OBJECTS) $(libs_parser_libkconfig_parser_la_LIBADD) $(LIBS)
frontends/conf/$(am__dirstamp):
	@$(MKDIR_P) frontends/conf
	@: >>frontends/conf/$(am__dirstamp)
frontends/conf/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) frontends/conf/$(DEPDIR)
	@: >>frontends/conf/$(DEPDIR)/$(am__dirstamp)
frontends/conf/kconfig_conf-conf.$(OBJEXT):  \
	frontends/conf/$(am__dirstamp) \
	frontends/conf/$(DEPDIR)/$(am__dirstamp)

frontends/conf/kconfig-conf$(EXEEXT): $(frontends_conf_kconfig_conf_OBJECTS) $(frontends_conf_kconfig_conf_DEPENDENCIES) $(EXTRA_frontends_conf_kconfig_conf_DEPENDENCIES) frontends/conf/$(am__dirstamp)
	@rm -f frontends/conf/kconfig-conf$(EXEEXT)
	$(AM_V_CCLD)$(frontends_conf_kconfig_conf_LINK) $(frontends_conf_kconfig_conf_OBJECTS) $(frontends_conf_kconfig_conf_LDADD) $(LIBS)
utils/$(am__dirstamp):
	@$(MKDIR_P) utils
	@: >>utils/$(am__dirstamp)
utils/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) utils/$(DEPDIR)
	@: >>utils/$(DEPDIR)/$(am__dirstamp)
utils/kconfig_gettext-gettext.$(OBJEXT): utils/$(am__dirstamp) \
	utils/$(DEPDIR)/$(am__dirstamp)

utils/kconfig-gettext$(EXEEXT): $(utils_kconfig_gettext_OBJECTS) $(utils_kconfig_gettext_DEPENDENCIES) $(EXTRA_utils_kconfig_gettext_DEPENDENCIES) utils/$(am__dirstamp)
	@rm -f utils/kconfig-gettext$(EXEEXT)
	$(AM_V_CCLD)$(utils_kconfig_gettext_LINK) $(utils_kconfig_gettext_OBJECTS) $(utils_kconfig_gettext_LDADD) $(LIBS)
install-binSCRIPTS: $(bin_SCRIPTS)
	@$(NORMAL_INSTALL)
	@list='$(bin_SCRIPTS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  if test -f "$$d$$p"; then echo "$$d$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n' \
	    -e 'h;s|.*|.|' \
	    -e 'p;x;s,.*/,,;$(transform)' | sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1; } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) { files[d] = files[d] " " $$1; \
	      if (++n[d] == $(am__install_max)) { \
		print "f", d, files[d]; n[d] = 0; files[d] = "" } } \
	    else { print "f", d "/" $$4, $$1 } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	     if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	     test -z "$$files" || { \
	       echo " $(INSTALL_SCRIPT) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	       $(INSTALL_SCRIPT) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	     } \
	; done

uninstall-binSCRIPTS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_SCRIPTS)'; test -n "$(bindir)" || exit 0; \
	files=`for p in $$list; do echo "$$p"; done | \
	       sed -e 's,.*/,,;$(transform)'`; \
	dir='$(DESTDIR)$(bindir)'; $(am__uninstall_files_from_dir)
install-dist_binSCRIPTS: $(dist_bin_SCRIPTS)
	@$(NORMAL_INSTALL)
	@list='$(dist_bin_SCRIPTS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  if test -f "$$d$$p"; then echo "$$d$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n' \
	    -e 'h;s|.*|.|' \
	    -e 'p;x;s,.*/,,;$(transform)' | sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1; } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) { files[d] = files[d] " " $$1; \
	      if (++n[d] == $(am__install_max)) { \
		print "f", d, files[d]; n[d] = 0; files[d] = "" } } \
	    else { print "f", d "/" $$4, $$1 } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	     if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	     test -z "$$files" || { \
	       echo " $(INSTALL_SCRIPT) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	       $(INSTALL_SCRIPT) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	     } \
	; done

uninstall-dist_binSCRIPTS:
	@$(NORMAL_UNINSTALL)
	@list='$(dist_bin_SCRIPTS)'; test -n "$(bindir)" || exit 0; \
	files=`for p in $$list; do echo "$$p"; done | \
	       sed -e 's,.*/,,;$(transform)'`; \
	dir='$(DESTDIR)$(bindir)'; $(am__uninstall_files_from_dir)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f frontends/conf/*.$(OBJEXT)
	-rm -f libs/parser/*.$(OBJEXT)
	-rm -f libs/parser/*.lo
	-rm -f utils/*.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

